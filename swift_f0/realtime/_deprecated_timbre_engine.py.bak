"""
Timbre transformation engine using FluidSynth or MIDI synthesis.

This module handles real-time timbre transformation of audio based on detected pitch.
"""

import numpy as np
from typing import Optional, Dict, Any, List, Tuple
from dataclasses import dataclass
import os

try:
    import fluidsynth
    FLUIDSYNTH_AVAILABLE = True
except ImportError:
    FLUIDSYNTH_AVAILABLE = False
    print("Warning: FluidSynth not available. Install with: pip install pyfluidsynth")


@dataclass
class TimbreConfig:
    """Configuration for timbre transformation."""

    soundfont_path: str = None  # Path to SF2 soundfont file
    instrument: int = 0  # GM instrument number (0-127)
    volume: float = 0.8  # Volume (0.0 to 1.0)
    reverb: float = 0.2  # Reverb amount (0.0 to 1.0)
    chorus: float = 0.0  # Chorus amount (0.0 to 1.0)

    # Pitch correction
    auto_tune: bool = False
    auto_tune_strength: float = 0.8  # 0.0 = no correction, 1.0 = full correction
    target_scale: str = "chromatic"  # or "major", "minor", etc.

    # Performance
    polyphony: int = 16  # Maximum simultaneous notes
    interpolation: str = "linear"  # or "cubic"


class TimbreEngine:
    """
    Real-time timbre transformation engine.

    Converts monophonic audio to different instrument timbres based on detected pitch.
    """

    def __init__(self, config: Optional[TimbreConfig] = None):
        """
        Initialize timbre engine.

        Args:
            config: Timbre configuration
        """
        self.config = config or TimbreConfig()

        # Find soundfont file if not specified
        if self.config.soundfont_path is None:
            self.config.soundfont_path = self._find_soundfont()

        # Initialize synthesis engine
        self.synth = None
        self.audio_driver = None
        self.current_notes: Dict[int, float] = {}  # MIDI note -> velocity

        if FLUIDSYNTH_AVAILABLE and self.config.soundfont_path:
            self._init_fluidsynth()

    def _find_soundfont(self) -> Optional[str]:
        """Find default soundfont file."""
        # Check project soundfonts directory
        project_root = os.path.dirname(os.path.dirname(os.path.dirname(__file__)))
        soundfont_path = os.path.join(project_root, "soundfonts", "GeneralUser-GS.sf2")

        if os.path.exists(soundfont_path):
            return soundfont_path

        # Check common system locations
        common_paths = [
            "/usr/share/sounds/sf2/FluidR3_GM.sf2",
            "/usr/share/soundfonts/FluidR3_GM.sf2",
            "C:\\soundfonts\\GeneralUser-GS.sf2",
        ]

        for path in common_paths:
            if os.path.exists(path):
                return path

        print("Warning: No soundfont file found. Timbre transformation disabled.")
        return None

    def _init_fluidsynth(self):
        """Initialize FluidSynth synthesizer."""
        try:
            # Create synthesizer
            self.synth = fluidsynth.Synth()

            # Configure settings
            self.synth.setting('synth.gain', self.config.volume)
            self.synth.setting('synth.reverb.active', 1 if self.config.reverb > 0 else 0)
            self.synth.setting('synth.reverb.room-size', self.config.reverb)
            self.synth.setting('synth.chorus.active', 1 if self.config.chorus > 0 else 0)
            self.synth.setting('synth.polyphony', self.config.polyphony)

            # Load soundfont
            sfid = self.synth.sfload(self.config.soundfont_path)
            if sfid < 0:
                raise RuntimeError(f"Failed to load soundfont: {self.config.soundfont_path}")

            # Select instrument
            self.synth.program_select(0, sfid, 0, self.config.instrument)

            # Start audio driver (optional, for direct output)
            # self.audio_driver = fluidsynth.AudioDriver(self.synth)

            print(f"FluidSynth initialized with soundfont: {self.config.soundfont_path}")

        except Exception as e:
            print(f"Failed to initialize FluidSynth: {e}")
            self.synth = None

    def transform_with_pitch(
        self,
        audio_chunk: np.ndarray,
        pitch_hz: float,
        confidence: float,
        sample_rate: int = 16000
    ) -> np.ndarray:
        """
        Transform audio chunk with known pitch.

        Args:
            audio_chunk: Input audio samples
            pitch_hz: Detected pitch in Hz
            confidence: Pitch detection confidence (0-1)
            sample_rate: Audio sample rate

        Returns:
            Transformed audio with new timbre
        """
        if not FLUIDSYNTH_AVAILABLE or self.synth is None:
            return audio_chunk  # Return original if synthesis not available

        # Convert pitch to MIDI note
        midi_note = self._hz_to_midi(pitch_hz)

        # Apply auto-tune if enabled
        if self.config.auto_tune:
            midi_note = self._quantize_to_scale(midi_note)
            pitch_hz = self._midi_to_hz(midi_note)

        # Calculate velocity from audio amplitude
        velocity = self._calculate_velocity(audio_chunk, confidence)

        # Synthesize audio
        return self._synthesize_note(midi_note, velocity, len(audio_chunk), sample_rate)

    def _synthesize_note(
        self,
        midi_note: int,
        velocity: int,
        n_samples: int,
        sample_rate: int
    ) -> np.ndarray:
        """
        Synthesize audio for a MIDI note.

        Args:
            midi_note: MIDI note number (0-127)
            velocity: Note velocity (0-127)
            n_samples: Number of samples to generate
            sample_rate: Sample rate

        Returns:
            Synthesized audio
        """
        if self.synth is None:
            return np.zeros(n_samples, dtype=np.float32)

        # Update note state
        self._update_note_state(midi_note, velocity)

        # Generate audio samples
        # FluidSynth generates stereo by default
        samples = np.zeros((n_samples, 2), dtype=np.float32)

        # This is a simplified version - actual implementation would need
        # proper FluidSynth integration for sample generation
        # For now, return silence or original

        # Convert to mono if needed
        if samples.shape[1] > 1:
            samples = np.mean(samples, axis=1)

        return samples

    def _update_note_state(self, midi_note: int, velocity: int):
        """Update currently playing notes."""
        # Turn off notes that changed
        for note in list(self.current_notes.keys()):
            if note != midi_note:
                self.synth.noteoff(0, note)
                del self.current_notes[note]

        # Turn on new note or update velocity
        if midi_note not in self.current_notes:
            if velocity > 0:
                self.synth.noteon(0, midi_note, velocity)
                self.current_notes[midi_note] = velocity
        elif velocity == 0:
            # Note off
            self.synth.noteoff(0, midi_note)
            if midi_note in self.current_notes:
                del self.current_notes[midi_note]

    def _calculate_velocity(self, audio_chunk: np.ndarray, confidence: float) -> int:
        """Calculate MIDI velocity from audio amplitude and confidence."""
        # RMS amplitude
        rms = np.sqrt(np.mean(audio_chunk ** 2))

        # Convert to velocity (0-127)
        # Assuming -1 to 1 audio range
        velocity = int(min(127, max(0, rms * 127 * confidence)))

        return velocity

    def _quantize_to_scale(self, midi_note: float) -> int:
        """Quantize MIDI note to nearest scale degree."""
        if self.config.target_scale == "chromatic":
            return round(midi_note)

        # Define scales (intervals from root)
        scales = {
            "major": [0, 2, 4, 5, 7, 9, 11],
            "minor": [0, 2, 3, 5, 7, 8, 10],
            "pentatonic": [0, 2, 4, 7, 9],
            "blues": [0, 3, 5, 6, 7, 10],
        }

        if self.config.target_scale not in scales:
            return round(midi_note)

        scale = scales[self.config.target_scale]

        # Find octave and note within octave
        octave = int(midi_note // 12)
        note_in_octave = midi_note % 12

        # Find nearest scale degree
        distances = [(abs(note_in_octave - s), s) for s in scale]
        nearest = min(distances)[1]

        # Apply auto-tune strength
        quantized = octave * 12 + nearest
        return round(midi_note * (1 - self.config.auto_tune_strength) +
                    quantized * self.config.auto_tune_strength)

    def _hz_to_midi(self, frequency: float) -> float:
        """Convert frequency in Hz to MIDI note number."""
        if frequency <= 0:
            return 0
        return 69 + 12 * np.log2(frequency / 440.0)

    def _midi_to_hz(self, midi_note: float) -> float:
        """Convert MIDI note number to frequency in Hz."""
        return 440.0 * (2 ** ((midi_note - 69) / 12))

    def set_instrument(self, instrument: int):
        """
        Change instrument.

        Args:
            instrument: GM instrument number (0-127)
        """
        self.config.instrument = max(0, min(127, instrument))
        if self.synth:
            self.synth.program_change(0, self.config.instrument)

    def cleanup(self):
        """Clean up resources."""
        # Turn off all notes
        if self.synth:
            for note in self.current_notes:
                self.synth.noteoff(0, note)
            self.current_notes.clear()

        # Cleanup audio driver
        if self.audio_driver:
            del self.audio_driver
            self.audio_driver = None

        # Cleanup synthesizer
        if self.synth:
            del self.synth
            self.synth = None